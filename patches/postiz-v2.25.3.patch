+++ b/apps/backend/src/api/routes/enterprise.controller.ts
@@ -1 +1,2 @@
-import { Body, Controller, Param, Post, Res } from '@nestjs/common';
+import { Body, Controller, Headers, HttpException, Param, Post, Res } from '@nestjs/common';
+import { createHmac, timingSafeEqual } from 'crypto';
@@ -19,0 +21,71 @@ export class EnterpriseController {
+  @Post('/managed-tenants')
+  async createManagedTenant(
+    @Body() body: { externalId?: string; name?: string },
+    @Headers('x-kb-timestamp') timestamp: string,
+    @Headers('x-kb-nonce') nonce: string,
+    @Headers('x-kb-signature') signature: string
+  ) {
+    const secret = process.env.KOOLBRAND_TENANT_PROVISIONER_SECRET;
+    const operatorUserId = process.env.KOOLBRAND_POSTIZ_OPERATOR_USER_ID;
+    if (!secret || secret.length < 32 || !operatorUserId) {
+      throw new HttpException('Tenant provisioner is not configured', 503);
+    }
+    if (
+      typeof body?.externalId !== 'string' ||
+      !/^[a-z0-9][a-z0-9_-]{1,63}$/.test(body.externalId) ||
+      typeof body?.name !== 'string' ||
+      body.name.trim().length < 3 ||
+      body.name.trim().length > 128 ||
+      !timestamp || !/^\d{10,13}$/.test(timestamp) ||
+      !nonce || !/^[a-f0-9]{32,64}$/.test(nonce) ||
+      !signature || !/^[a-f0-9]{64}$/.test(signature)
+    ) {
+      throw new HttpException('Invalid tenant provisioning request', 400);
+    }
+    const sentAt = Number(timestamp);
+    const sentAtMs = timestamp.length === 10 ? sentAt * 1000 : sentAt;
+    if (!Number.isSafeInteger(sentAtMs) || Math.abs(Date.now() - sentAtMs) > 60_000) {
+      throw new HttpException('Expired tenant provisioning request', 401);
+    }
+
+    const tenantName = body.name.trim();
+    const canonical = JSON.stringify([
+      'POST',
+      '/api/enterprise/managed-tenants',
+      timestamp,
+      nonce,
+      body.externalId,
+      tenantName,
+    ]);
+    const expected = createHmac('sha256', secret).update(canonical).digest();
+    const provided = Buffer.from(signature, 'hex');
+    if (provided.length !== expected.length || !timingSafeEqual(provided, expected)) {
+      throw new HttpException('Invalid tenant provisioner signature', 401);
+    }
+
+    const claimed = await ioRedis.set(
+      `kb:tenant-provisioning:nonce:${nonce}`,
+      '1',
+      'EX',
+      120,
+      'NX'
+    );
+    if (claimed !== 'OK') {
+      throw new HttpException('Replayed tenant provisioning request', 409);
+    }
+
+    const tenant = await this._organizationService.createManagedOrganization(
+      body.externalId,
+      tenantName,
+      operatorUserId
+    );
+    // This is a server-to-server endpoint. The key is consumed by the Mac mini
+    // provisioner and must never be called from or exposed to a browser.
+    return {
+      externalId: body.externalId,
+      organizationId: tenant.id,
+      name: tenant.name,
+      apiKey: tenant.apiKey,
+    };
+  }
+
