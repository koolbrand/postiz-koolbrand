diff --git a/docs/postforme-quickstart-tiktok.md b/docs/postforme-quickstart-tiktok.md
new file mode 100644
index 0000000..dfa2055
--- /dev/null
+++ b/docs/postforme-quickstart-tiktok.md
@@ -0,0 +1,70 @@
+# Post for Me Quickstart: TikTok vertical slice
+
+**Status: prototype, disabled by default. Not a complete or production-ready
+Post for Me integration.** This adds a separate `tiktok-postforme` identifier
+with an optional TikTok connection and asynchronous publish path while reusing
+Postiz's existing TikTok composer and settings. It does not alter existing
+native TikTok channels. No real OAuth, account, spend, vendor contact, or
+deployment was performed.
+
+## Configuration and security boundary
+
+The adapter is selected only when all of the following are set in the backend
+environment:
+
+- `POSTFORME_TIKTOK_ENABLED=true`
+- `POSTFORME_API_KEY` (server-side only)
+- `POSTFORME_PROJECT_ID`
+
+Without all three, new TikTok connections use the existing native provider
+flow. A Post for Me callback received while disabled is rejected. Never expose
+the API key or Post for Me account tokens to the browser. The Postiz
+integration stores only an opaque `postforme:<account-id>` reference.
+
+Post for Me's callback has no OAuth state. On OAuth start, the backend sends
+the authenticated `Organization.id` as `external_id` and stores one short-lived
+pending transaction per organization in Redis. On callback, the backend looks
+up the account using its API key, checks project/provider/success and the
+vendor-returned account's TikTok platform, connected status and `external_id`,
+then consumes that organization's pending transaction once. It accepts exactly
+one account per channel; cancellation, zero accounts, multiple accounts,
+expired/replayed callbacks, or tenant mismatch fail closed. A second concurrent
+connection for the same organization is rejected while one is pending.
+
+Before publishing or polling, the backend re-fetches the account and verifies
+its ID, TikTok platform, connected status and tenant `external_id`. Each
+Postiz post/channel pair gets a deterministic, channel-scoped `external_id`.
+Before creating and while polling, the adapter queries
+`/v1/social-posts?external_id=` to recover an accepted request after an
+ambiguous timeout or malformed 2xx response. If it cannot yet find the post,
+the workflow stays pending rather than immediately submitting again. The
+pending workflow queries `/v1/social-post-results` and only completes when the
+single expected account result reports `success: true` with an HTTPS URL and
+platform post ID; explicit failure becomes a provider error and missing or
+incomplete results stay pending.
+
+Post for Me documents `external_id` as a linking identifier, not a request
+deduplication guarantee. The lookup reduces duplicate risk but cannot fully
+prevent duplicates if list results are eventually consistent or concurrent
+create requests race; resolve those cases before production.
+
+## Unsupported and unverified behavior
+
+- Analytics, media reconciliation and refresh/reconnect are not implemented.
+  Analytics/reconciliation calls fail closed for these opaque account
+  references. Deleting a Postiz channel first
+  calls Post for Me's account disconnect endpoint, revoking active tokens but
+  retaining the provider-side account history. If remote revocation fails,
+  Postiz keeps the channel so an operator can retry safely.
+  Keep the feature flag and API key configured until all attached channels
+  have been disconnected; disabling the adapter first blocks deletion.
+- The adapter accepts one TikTok account per Postiz channel. It does not
+  partially connect or publish across the callback's multiple-account result.
+- TikTok settings are mapped from Postiz's existing TikTok settings. Confirm
+  the exact Post for Me Quickstart TikTok field/value contract before enabling
+  the feature for a real organization.
+- A Post for Me project, API key, dashboard callback configuration and
+  non-production end-to-end verification are still required. Tests/build were
+  not run. Keep the feature flag off until the code receives review and
+  the callback/publish/results flow is verified against a non-production
+  project.
diff --git a/libraries/nestjs-libraries/src/database/prisma/organizations/organization.repository.ts b/libraries/nestjs-libraries/src/database/prisma/organizations/organization.repository.ts
index f70f71c..468a2a7 100644
--- a/libraries/nestjs-libraries/src/database/prisma/organizations/organization.repository.ts
+++ b/libraries/nestjs-libraries/src/database/prisma/organizations/organization.repository.ts
@@ -16,0 +17,69 @@ export class OrganizationRepository {
+  async createManagedOrganization(
+    externalId: string,
+    name: string,
+    operatorUserId: string
+  ) {
+    const operator = await this._user.model.user.findUnique({
+      where: { id: operatorUserId },
+      select: { id: true, isSuperAdmin: true, deletedAt: true },
+    });
+    if (!operator?.isSuperAdmin || operator.deletedAt) {
+      throw new Error('Configured Postiz tenant operator is not an active superadmin');
+    }
+
+    const existing = await this._organization.model.organization.findUnique({
+      where: { managedExternalId: externalId },
+      select: { id: true, name: true, apiKey: true },
+    });
+    if (existing) {
+      if (existing.name !== name) {
+        throw new Error('Managed external ID already belongs to a different organization name');
+      }
+      return existing;
+    }
+
+    try {
+      return await this._organization.model.organization.create({
+        select: { id: true, name: true, apiKey: true },
+        data: {
+          name,
+          managedExternalId: externalId,
+          apiKey: AuthService.fixedEncryption(makeSecureId(32)),
+          allowTrial: false,
+          isTrailing: false,
+          subscription: {
+            create: {
+              subscriptionTier: SubscriptionTier.PRO,
+              totalChannels: 30,
+              isLifetime: true,
+              period: 'YEARLY',
+              provider: 'self-hosted',
+            },
+          },
+          users: {
+            create: {
+              role: Role.ADMIN,
+              user: { connect: { id: operator.id } },
+            },
+          },
+        },
+      });
+    } catch (error: any) {
+      // A retry after a lost response, or concurrent requests with the same
+      // external ID, must return the one organization already created.
+      if (error?.code === 'P2002') {
+        const created = await this._organization.model.organization.findUnique({
+          where: { managedExternalId: externalId },
+          select: { id: true, name: true, apiKey: true },
+        });
+        if (created) {
+          if (created.name !== name) {
+            throw new Error('Managed external ID already belongs to a different organization name');
+          }
+          return created;
+        }
+      }
+      throw error;
+    }
+  }
+
